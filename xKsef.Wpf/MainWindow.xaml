<Window x:Class="xKsef.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xKsef - Przeglądarka faktur"
        Height="600"
        Width="1100">
    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="xKsef - Faktury zakupowe"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,15">

                <TextBlock Text="Od:"
                           VerticalAlignment="Center"/>

                <DatePicker SelectedDate="{Binding DateFrom}"
                            Margin="8,0,20,0"/>

                <TextBlock Text="Do:"
                           VerticalAlignment="Center"/>

                <DatePicker SelectedDate="{Binding DateTo}"
                            Margin="8,0,20,0"/>

                <Button Content="Pobierz faktury"
                        Command="{Binding LoadInvoicesCommand}"
                        Padding="15,6"/>

            </StackPanel>

        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Status}"
                   Margin="0,10,0,0"/>


            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <TabItem Header="Sprzedaż">
                <DataGrid ItemsSource="{Binding SalesInvoices}"
              AutoGenerateColumns="True"
              IsReadOnly="True" />
            </TabItem>

            <TabItem Header="Zakup">
                <DataGrid ItemsSource="{Binding PurchaseInvoices}"
              AutoGenerateColumns="True"
              IsReadOnly="True" />
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>