<Window x:Class="xKsef.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xKsef - Przeglądarka faktur"
        Height="600"
        Width="1100">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Górny pasek -->
            <RowDefinition Height="50"/>

            <!-- Główna zawartość -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- GÓRNY PASEK -->
        <Grid Grid.Row="0"
              Background="#F0F0F0">

            <TextBlock Text="xKsef"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>

            <Button Content="Zaloguj" Width="100"
Height="30"
HorizontalAlignment="Right"
VerticalAlignment="Center"
Margin="5,0"
        Command="{Binding LoginCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Wyloguj" Width="100"
Height="30"
HorizontalAlignment="Right"
VerticalAlignment="Center"
Margin="5,0"
        Command="{Binding LogoutCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- GŁÓWNA ZAWARTOŚĆ -->
        <DockPanel Grid.Row="1"
                   Margin="15">

            <StackPanel DockPanel.Dock="Top">

                <TextBlock Text="xKsef - Faktury zakupowe"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,15">

                    <TextBlock Text="Od:"
                               VerticalAlignment="Center"/>

                    <DatePicker SelectedDate="{Binding DateFrom}"
                                Margin="8,0,20,0"/>

                    <TextBlock Text="Do:"
                               VerticalAlignment="Center"/>

                    <DatePicker SelectedDate="{Binding DateTo}"
                                Margin="8,0,20,0"/>

                    <Button Content="Pobierz faktury"
                            Command="{Binding LoadInvoicesCommand}"
                            Padding="15,6"/>

                </StackPanel>
            </StackPanel>

            <!-- Pasek statusu -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding Status}"
                       Margin="0,10,0,0"/>

            <!-- Zakładki faktur -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                <TabItem Header="Sprzedaż">
                    <DataGrid ItemsSource="{Binding SalesInvoices}" SelectedItem="{Binding SelectedSalesInvoice, Mode=TwoWay}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"/>
                </TabItem>

                <TabItem Header="Zakup">
                    <DataGrid ItemsSource="{Binding PurchaseInvoices}" SelectedItem="{Binding SelectedPurchaseInvoice, Mode=TwoWay}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"/>
                </TabItem>

            </TabControl>

        </DockPanel>
    </Grid>
</Window>
