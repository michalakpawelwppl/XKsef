<Window x:Class="xKsef.Wpf.Views.TenantUsersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Użytkownicy tenanta" Width="760" Height="490" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="Nadaj dostęp istniejącemu użytkownikowi — dokładny login lub e-mail" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="280" MaxLength="256" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Width="100" Margin="8,0" ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}"/>
                <Button Content="Dodaj dostęp" Command="{Binding AddCommand}" Padding="12,4"/>
            </StackPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="*"/><DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="2*"/><DataGridTextColumn Header="Rola" Binding="{Binding Role}" Width="90"/></DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
            <ComboBox Width="100" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" IsEnabled="{Binding CanModify}"/>
            <Button Content="Zmień rolę" Command="{Binding SetRoleCommand}" Padding="12,4" Margin="8,0"/>
            <Button Content="Odbierz dostęp" Command="{Binding RemoveCommand}" Padding="12,4"/>
            <Button Content="Odśwież" Command="{Binding RefreshCommand}" Padding="12,4" Margin="8,0"/>
        </StackPanel>
        <DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="Zamknij" Command="{Binding CloseCommand}" IsCancel="True" Padding="16,4"/><TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
    </Grid>
</Window>