<Window x:Class="xKsef.Wpf.Views.NewTenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy tenant" Width="450" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <StackPanel IsEnabled="{Binding CanEdit}">
            <TextBlock Text="Nazwa tenanta" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,12"/>
            <TextBlock Text="NIP" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Nip, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,0,0,12"/>
            <TextBlock Text="Nazwa podmiotu podatkowego" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TaxEntityName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,12"/>
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Command="{Binding CancelCommand}" IsCancel="True" Width="90" Margin="0,0,10,0"/>
            <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True" Width="90"/>
        </StackPanel>
    </StackPanel>
</Window>
