<Window x:Class="xKsef.Wpf.Views.KsefTokenWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:behaviors="clr-namespace:xKsef.Wpf.Behaviors"
        Title="Konfiguracja tokenu KSeF" Height="220" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Wprowadź token uwierzytelniający KSeF:" Margin="0,0,0,10" />
        <PasswordBox Grid.Row="1" Height="30" behaviors:PasswordBoxHelper.BoundPassword="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Text="Token zostanie przesłany do bezpiecznego magazynu poświadczeń." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="Gray" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="90" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
            <Button Content="Zapisz" Width="90" IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>