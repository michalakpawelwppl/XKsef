# Credentials come from Visual Studio process environment variables; never commit their values.
@xKsef.Api_HostAddress = https://localhost:7127
@tenantId = {{$processEnv XKSEF_TENANT_ID}}
@contractorId = {{$processEnv XKSEF_CONTRACTOR_ID}}

GET {{xKsef.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

GET {{xKsef.Api_HostAddress}}/api/ksef-test/invoice-count

###
GET https://localhost:7127/api/invoices?from=2026-10-01&to=2026-10-30&direction=Sales
X-Tenant-Id: {{tenantId}}
Authorization : Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
###
GET https://localhost:7127/api/invoices?from=2026-10-01&to=2026-10-11&direction=Purchase

###

GET {{xKsef.Api_HostAddress}}/api/ksef-test/invoice-count

###

@ksefNumber = {{$processEnv XKSEF_INVOICE_KSEF_NUMBER}}
GET {{xKsef.Api_HostAddress}}/api/invoices/{{ksefNumber}}/xml

###

POST {{xKsef.Api_HostAddress}}/api/invoices/import?direction=Purchase
Authorization : Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
###

POST {{xKsef.Api_HostAddress}}/api/auth/login
Content-Type: application/json
{
  "login": "{{$processEnv XKSEF_API_LOGIN}}",
  "password": "{{$processEnv XKSEF_API_PASSWORD}}"
}

###

POST {{xKsef.Api_HostAddress}}/api/invoices/import

###

GET {{xKsef.Api_HostAddress}}/api/auth/auth-test
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}

###

GET {{xKsef.Api_HostAddress}}/api/invoices/{{ksefNumber}}/pdf
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
###

POST {{xKsef.Api_HostAddress}}/api/invoices/import

###

POST {{xKsef.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  //LoginRequest
}

###

GET {{xKsef.Api_HostAddress}}/api/tenants
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
###

GET {{xKsef.Api_HostAddress}}/api/tenants

###

GET {{xKsef.Api_HostAddress}}/api/tenants

###

POST {{xKsef.Api_HostAddress}}/api/ksef/authentication/prepare
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
###

POST {{xKsef.Api_HostAddress}}/api/ksef/authentication/prepare

###

POST {{xKsef.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  //LoginRequest
}

###

POST {{xKsef.Api_HostAddress}}/api/invoices/import/ksef
Content-Type: application/json

{
  //DateOnly
}

###

POST {{xKsef.Api_HostAddress}}/api/invoices/import/ksef
Content-Type: application/json

{
  //DateOnly
}

###

POST  {{xKsef.Api_HostAddress}}/api/invoices/import/ksef?from=2026-10-31&to=2026-10-31&direction=Purchase

Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
###
{
  //DateOnly
}

###

GET {{xKsef.Api_HostAddress}}/api/ksef-test/invoice-count

###

GET {{xKsef.Api_HostAddress}}/api/tenants

###

POST {{xKsef.Api_HostAddress}}/api/ksef/credentials/token
Content-Type: application/json
Authorization : Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
{
    "token": "{{$processEnv XKSEF_KSEF_TEST_TOKEN}}"
}
###

GET {{xKsef.Api_HostAddress}}/api/ksef/credentials/token
Authorization : Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
###

POST {{xKsef.Api_HostAddress}}/api/contractors
Content-Type: application/json
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
{
  "shortName": "TEST KONTRAHENT",
  "fullName": "Firma Testowa Spółka z ograniczoną odpowiedzialnością",
  "nip": null,
  "regon": null,
  "krsNumber": null,
  "euVatNumber": null,
  "otherTaxNumber": null,
  "isEuVatRegistered": false,
  "addresses": [
    {
      "addressType": 1,
      "countryCode": "PL",
      "city": "Poznań",
      "postalCode": "60-001",
      "street": "Testowa",
      "buildingNumber": "10",
      "apartmentNumber": "2"
    }
  ]
}

###

PUT {{xKsef.Api_HostAddress}}/api/contractors/{{contractorId}}
Content-Type: application/json
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
{
  "shortName": "TEST ZMIENIONY",
  "fullName": "Firma Testowa Po Aktualizacji",
  "nip": null,
  "regon": null,
  "krsNumber": null,
  "euVatNumber": null,
  "otherTaxNumber": null,
  "isEuVatRegistered": false,
  "isActive": true,
  "addresses": [
    {
      "addressType": 1,
      "countryCode": "PL",
      "city": "Warszawa",
      "postalCode": "60-001",
      "street": "Testowa",
      "buildingNumber": "25",
      "apartmentNumber": "2"
    }
  ]
}
###

GET {{xKsef.Api_HostAddress}}/api/contractors
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
###

GET {{xKsef.Api_HostAddress}}/api/contractors/{{contractorId}}
Authorization: Bearer {{$processEnv XKSEF_API_BEARER_TOKEN}}
X-Tenant-Id: {{tenantId}}
