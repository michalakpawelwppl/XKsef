    <EnvironmentVariables>
      <XKSEF_RUN_GUS_BIR_LOGIN_ONLY_TEST>1</XKSEF_RUN_GUS_BIR_LOGIN_ONLY_TEST>
      <XKSEF_RUN_GUS_BIR_LIVE_TEST>0</XKSEF_RUN_GUS_BIR_LIVE_TEST>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
